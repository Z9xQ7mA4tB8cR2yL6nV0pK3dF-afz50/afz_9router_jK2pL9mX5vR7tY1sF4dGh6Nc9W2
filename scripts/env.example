# Copy to /etc/opencode-stack.env, then: chmod 600 /etc/opencode-stack.env
# Used by opencode serve and both proxy ports. No systemd needed.
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-strong-password
OPENCODE_PASSWORD=replace-with-a-strong-password

# afz26 = key required on 4097; 7015 trusts loopback for the hidden router.
# Leave blank for passwordless mode (then no key is required anywhere).
PROXY_API_KEY=afz26

MODEL=opencode/deepseek-v4.1-flash-free
VARIANT=max
TOOLS_MODE=safe
SANDBOX_DIR=/var/lib/opencode-proxy/sandbox
HOST=127.0.0.1
REQUEST_TIMEOUT_MS=120000
START_TIMEOUT_MS=30000
POLL_MS=350
